{# The same bubbles and action cards as the chat panel, read-only; their CSS comes with the panel on every admin page. #}
{% set conversation = hookable_metadata.context.resource %}
<div class="card mb-3">
    <div class="card-header">
        <div class="card-title">{{ 'sylius.ui.history'|trans }}</div>
    </div>
    <div class="card-body ask-ai__messages" data-test-timeline>
        {% for item in sylius_ask_ai_timeline(conversation) %}
            {% if item.role is defined %}
                {{ include('@SyliusAskAiPlugin/component/message.html.twig', { message: item }) }}
            {% else %}
                {{ include('@SyliusAskAiPlugin/component/action_card.html.twig', { action: item, interactive: false, link: true }) }}
            {% endif %}
        {% else %}
            <p class="text-secondary m-0">{{ 'sylius.ui.no_results'|trans }}</p>
        {% endfor %}
    </div>
</div>

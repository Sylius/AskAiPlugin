{# Only the administrator who had the conversation can pick it up again in the chat panel. #}
{% if conversation.adminUser.id == app.user.id %}
    <form action="{{ path('sylius_ai_assistant_admin_conversation_resume', { id: conversation.id }) }}" method="post" class="d-inline">
        {% if sylius_csrf_protection_enabled() %}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token(conversation.id) }}" />
        {% endif %}
        {% if icon_only %}
            <button type="submit" class="btn btn-icon" data-bs-toggle="tooltip" data-bs-title="{{ label|trans }}" {{ sylius_test_html_attribute('resume-conversation', conversation.id) }}>
                {{ ux_icon('tabler:player-play') }}
            </button>
        {% else %}
            <button type="submit" class="btn" {{ sylius_test_html_attribute('resume-conversation', conversation.id) }}>
                {{ ux_icon('tabler:player-play') }}
                {{ label|trans }}
            </button>
        {% endif %}
    </form>
{% endif %}

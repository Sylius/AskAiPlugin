<div class="ai-assistant__message ai-assistant__message--{{ message.role }}">
    {%- if message.role == 'notice' -%}
        <div class="ai-assistant__notice small text-secondary bg-secondary-lt rounded-3 px-3 py-1 text-center">{{ message.content|nl2br }}</div>
    {%- else -%}
        <div class="ai-assistant__bubble">
            {%- if message.role == 'assistant' -%}
                {{ message.content|sylius_ai_assistant_markdown }}
            {%- else -%}
                {{ message.content|nl2br }}
            {%- endif -%}
        </div>
    {%- endif -%}
    {% if message.toolCalls is not empty %}
        <div class="ai-assistant__tools d-flex flex-wrap gap-1 small">
            {% for call in message.toolCalls %}
                <details class="ai-assistant__tool">
                    <summary class="badge bg-secondary-lt text-secondary font-monospace fw-normal">{{ call.name }}</summary>
                    {% if call.arguments is not empty %}
                        <dl class="ai-assistant__arguments font-monospace bg-body border rounded-2 px-2 py-1 mt-1 mb-0">
                            {% for name, value in call.arguments %}
                                <div class="text-break"><dt class="d-inline fw-normal text-secondary">{{ name }}:</dt> <dd class="d-inline m-0">{{ value is iterable or value is null or value is same as(true) or value is same as(false) ? value|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) : value }}</dd></div>
                            {% endfor %}
                        </dl>
                    {% endif %}
                </details>
            {% endfor %}
        </div>
    {% endif %}
</div>

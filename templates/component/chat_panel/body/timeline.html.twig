{% set panel = hookable_metadata.context.panel %}
{% for item in hookable_metadata.context.timeline %}
    {% if item.role is defined %}
        {{ include('@SyliusAskAiPlugin/component/message.html.twig', { message: item }) }}
    {% else %}
        {{ include('@SyliusAskAiPlugin/component/action_card.html.twig', { action: item }) }}
    {% endif %}
{% endfor %}
{% if panel.running %}
    <div class="ask-ai__message ask-ai__message--assistant">
        <div class="d-flex align-items-center gap-2">
            <div class="ask-ai__bubble ask-ai__typing" role="status" aria-label="{{ 'sylius_ask_ai.ui.thinking'|trans }}">
                <span></span><span></span><span></span>
            </div>
            <button type="button" class="btn btn-link btn-sm p-0 text-secondary" data-action="live#action" data-live-action-param="cancel">{{ 'sylius_ask_ai.ui.cancel'|trans }}</button>
        </div>
    </div>
{% endif %}

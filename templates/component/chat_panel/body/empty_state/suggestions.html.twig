{% set panel = hookable_metadata.context.panel %}
{% if panel.conversation is not null and panel.suggestions is not empty %}
    <div class="d-grid gap-2">
        {% for suggestion in panel.suggestions %}
            {% set text = suggestion|trans %}
            <button type="button" class="btn justify-content-start text-start text-wrap" data-ask-ai-suggestion="{{ text }}">{{ text }}</button>
        {% endfor %}
    </div>
{% endif %}

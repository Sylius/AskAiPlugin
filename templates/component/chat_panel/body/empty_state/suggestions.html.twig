{% if hookable_metadata.context.panel.conversation is not null %}
    <div class="d-grid gap-2">
        {% for key in ['what_are_the_latest_orders', 'which_orders_are_waiting_to_be_shipped', 'create_a_customer_group_called_vip'] %}
            {% set suggestion = ('sylius_ai_assistant.ui.suggestion.' ~ key)|trans %}
            <button type="button" class="btn justify-content-start text-start text-wrap" data-ai-assistant-suggestion="{{ suggestion }}">{{ suggestion }}</button>
        {% endfor %}
    </div>
{% endif %}

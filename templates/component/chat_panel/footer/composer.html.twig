{% set panel = hookable_metadata.context.panel %}
{% if panel.conversation is null %}
    <button type="button" class="btn btn-primary w-100" data-action="live#action" data-live-action-param="startConversation">{{ 'sylius_ask_ai.ui.start_conversation'|trans }}</button>
{% else %}
    <form data-action="live#action:prevent" data-live-action-param="send" class="ask-ai__composer d-flex align-items-end gap-2 border rounded-3 p-1">
        <textarea class="form-control flex-fill border-0 shadow-none px-2 ask-ai__input" rows="1" placeholder="{{ 'sylius_ask_ai.ui.ask_about_orders_products_promotions'|trans }}"
                  aria-label="{{ 'sylius_ask_ai.ui.ask_about_orders_products_promotions'|trans }}"
                  data-model="draft" autocomplete="off" {{ panel.running ? 'disabled' : '' }}></textarea>
        <button type="submit" class="btn btn-primary btn-sm flex-shrink-0 lh-1 p-2 m-1" title="{{ 'sylius_ask_ai.ui.send'|trans }}" aria-label="{{ 'sylius_ask_ai.ui.send'|trans }}" {{ panel.running ? 'disabled' : '' }}>
            {{ ux_icon('tabler:arrow-up', { class: 'icon m-0' }) }}
        </button>
    </form>
    <div class="form-hint small mt-1 px-1">{{ 'sylius_ask_ai.ui.enter_to_send'|trans }}</div>
{% endif %}

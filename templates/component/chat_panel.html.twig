<div {{ attributes.defaults({ class: 'ai-assistant d-flex flex-column-reverse align-items-end gap-3' ~ (open ? ' ai-assistant--open' : '') }) }}
    {% if open and (this.running or (this.conversation and this.conversation.pendingNavigation)) %}data-poll="delay({{ pollInterval }})|refresh"{% endif %}
>
    <button type="button" class="btn rounded-circle shadow p-2 ai-assistant__toggle" data-action="live#action" data-live-action-param="toggle"
            title="{{ 'sylius_ai_assistant.ui.ai_assistant'|trans }}" aria-label="{{ 'sylius_ai_assistant.ui.ai_assistant'|trans }}" aria-expanded="{{ open ? 'true' : 'false' }}">
        {% if open %}
            {{ ux_icon('tabler:x', { class: 'icon m-0' }) }}
        {% else %}
            <img src="{{ asset('bundles/syliusaiassistantplugin/images/assistant.webp') }}" alt="" class="w-100 h-100">
        {% endif %}
    </button>

    {% if open %}
        <div class="card ai-assistant__panel">
            {% hook 'sylius_ai_assistant.chat_panel' with { panel: this } %}
        </div>
    {% endif %}
</div>

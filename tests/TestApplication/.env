DATABASE_URL=mysql://root@127.0.0.1/sylius_ai_assistant_%kernel.environment%

SYLIUS_TEST_APP_BUNDLES_PATH="tests/TestApplication/config/bundles.php"
SYLIUS_TEST_APP_CONFIGS_TO_IMPORT="@SyliusAiAssistantPlugin/tests/TestApplication/config/config.yaml"
SYLIUS_TEST_APP_ROUTES_TO_IMPORT="@SyliusAiAssistantPlugin/tests/TestApplication/config/routes.yaml"

# Admin MCP plugin (required dependency) — dev-only keys shipped with sylius/test-application
SYLIUS_ADMIN_MCP_SERVER_API_URL=http://127.0.0.1:8000/api/v2/admin/
SYLIUS_ADMIN_MCP_SERVER_VERIFY_SSL=false
SYLIUS_ADMIN_MCP_SERVER_OAUTH_ENCRYPTION_KEY=ebf1f2279e1efe034658354133711f0222b1062d3aef97e9fec282ce6a0c960f
SYLIUS_ADMIN_MCP_SERVER_OAUTH_PRIVATE_KEY=%kernel.project_dir%/config/jwt/private.pem
SYLIUS_ADMIN_MCP_SERVER_OAUTH_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
SYLIUS_ADMIN_MCP_SERVER_OAUTH_PASSPHRASE=acme_plugin_development

# Symfony AI Mate: boot the test application as the host kernel
MATE_HOST_KERNEL=Sylius\\TestApplication\\Kernel

# Anthropic API key for the default "anthropic" platform; put the real one in .env.local (ignored by git)
ANTHROPIC_API_KEY=

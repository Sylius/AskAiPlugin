<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <mapped-superclass name="Sylius\AiAssistantPlugin\Entity\AgentAction" table="sylius_ai_assistant_agent_action">
        <id name="id" column="id" type="integer">
            <generator strategy="AUTO" />
        </id>

        <field name="state" column="state" type="string" length="16" />
        <field name="toolName" column="tool_name" type="string" length="128" nullable="true" />
        <field name="toolArguments" column="tool_arguments" type="json" nullable="true" />
        <field name="httpMethod" column="http_method" type="string" length="8" />
        <field name="path" column="path" type="string" length="255" />
        <field name="body" column="body" type="json" nullable="true" />
        <field name="snapshotBefore" column="snapshot_before" type="text" nullable="true" />
        <field name="result" column="result" type="text" nullable="true" />
        <field name="decidedAt" column="decided_at" type="datetime_immutable" nullable="true" />
        <field name="createdAt" column="created_at" type="datetime_immutable" />

        <many-to-one field="conversation" target-entity="Sylius\AiAssistantPlugin\Entity\ConversationInterface">
            <join-column name="conversation_id" referenced-column-name="id" nullable="false" on-delete="CASCADE" />
        </many-to-one>

        <many-to-one field="decidedBy" target-entity="Sylius\Component\Core\Model\AdminUserInterface">
            <join-column name="decided_by_id" referenced-column-name="id" nullable="true" on-delete="SET NULL" />
        </many-to-one>
    </mapped-superclass>

</doctrine-mapping>
